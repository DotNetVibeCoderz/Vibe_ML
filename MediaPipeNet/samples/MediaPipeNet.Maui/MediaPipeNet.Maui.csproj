<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MediaPipe.NET on Android and iOS (.NET MAUI). Not part of MediaPipeNet.slnx: building it needs the MAUI
    workloads (dotnet workload install maui-android maui-ios), which the CI images do not have.

      dotnet build samples/MediaPipeNet.Maui -f net10.0-android
      dotnet build samples/MediaPipeNet.Maui -t:Run -f net10.0-android     (device or emulator attached)

    iOS builds need a Mac (or a paired Mac). Created by Gravicode Studios, led by Kang Fadhil.
  -->
  <PropertyGroup>
    <!-- The repository default (net10.0) must not leak into this multi-targeted app. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>MediaPipe.NET</ApplicationTitle>
    <ApplicationId>com.gravicode.mediapipenet.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'ios'">15.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);XA0141;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <!-- The full ONNX Runtime package carries the Android (.aar, with NNAPI) and iOS (.xcframework, with CoreML) natives. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MediaPipeNet.Tasks.Vision\MediaPipeNet.Tasks.Vision.csproj" />
    <ProjectReference Include="..\..\src\MediaPipeNet.Visualization\MediaPipeNet.Visualization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Models travel inside the app package and are copied to app data on first launch (see ModelInstaller). -->
    <MauiAsset Include="..\..\models\onnx\face_detection_short_range.onnx" LogicalName="models/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\models\onnx\quantized\face_landmarks_detector_192.int8.onnx" LogicalName="models/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\models\onnx\quantized\face_landmarks_detector.int8.onnx" LogicalName="models/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\models\onnx\quantized\face_stylizer_color_sketch.int8.onnx" LogicalName="models/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\models\onnx\quantized\efficientdet_lite0.int8.onnx" LogicalName="models/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\tests\assets\images\portrait.jpg" LogicalName="samples/%(Filename)%(Extension)" />
    <MauiAsset Include="..\..\tests\assets\images\cats_and_dogs.jpg" LogicalName="samples/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
