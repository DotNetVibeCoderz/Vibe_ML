<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    MediaPipe.Net Gallery design tokens — "optics lab".
    Light chrome ("lab paper") around a dark viewfinder stage. Cobalt is the only UI accent;
    coral and mint are reserved for what the models see (overlays), never for chrome.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PaperColor">#EEF1F5</Color>
      <Color x:Key="PanelColor">#F8FAFC</Color>
      <Color x:Key="RaisedColor">#FFFFFF</Color>
      <Color x:Key="InkColor">#18202B</Color>
      <Color x:Key="InkMutedColor">#5B6676</Color>
      <Color x:Key="RuleColor">#D6DCE4</Color>
      <Color x:Key="CobaltColor">#2B59FF</Color>
      <Color x:Key="CobaltSoftColor">#E3E9FF</Color>
      <Color x:Key="SidebarColor">#E4E8EE</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PaperColor">#1A1E25</Color>
      <Color x:Key="PanelColor">#20252D</Color>
      <Color x:Key="RaisedColor">#262C35</Color>
      <Color x:Key="InkColor">#E6EAF0</Color>
      <Color x:Key="InkMutedColor">#98A2B3</Color>
      <Color x:Key="RuleColor">#343B46</Color>
      <Color x:Key="CobaltColor">#6D8BFF</Color>
      <Color x:Key="CobaltSoftColor">#2A3352</Color>
      <Color x:Key="SidebarColor">#15181E</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="PaperBrush" Color="{DynamicResource PaperColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{DynamicResource InkColor}" />
  <SolidColorBrush x:Key="InkMutedBrush" Color="{DynamicResource InkMutedColor}" />
  <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
  <SolidColorBrush x:Key="CobaltBrush" Color="{DynamicResource CobaltColor}" />
  <SolidColorBrush x:Key="CobaltSoftBrush" Color="{DynamicResource CobaltSoftColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />

  <!-- The stage is always dark: it is a viewfinder, independent of the chrome theme. -->
  <SolidColorBrush x:Key="StageBrush" Color="#12151B" />
  <SolidColorBrush x:Key="StageInkBrush" Color="#AEB8C6" />
  <SolidColorBrush x:Key="CoralBrush" Color="#FF5A36" />
  <SolidColorBrush x:Key="MintBrush" Color="#35E0B5" />

  <FontFamily x:Key="DisplayFont">avares://MediaPipeNet.Gallery/Assets/Fonts#Unbounded</FontFamily>
  <FontFamily x:Key="MonoFont">avares://MediaPipeNet.Gallery/Assets/Fonts#JetBrains Mono</FontFamily>
  <FontFamily x:Key="BodyFont">fonts:Inter#Inter</FontFamily>

  <x:Double x:Key="DisplaySize">30</x:Double>
  <x:Double x:Key="TitleSize">17</x:Double>
  <x:Double x:Key="BodySize">13.5</x:Double>
  <x:Double x:Key="CaptionSize">11.5</x:Double>
  <CornerRadius x:Key="PanelRadius">10</CornerRadius>
</ResourceDictionary>
