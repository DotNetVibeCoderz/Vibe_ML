<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Content-only model package. The ONNX files land in the consuming application's output folder under
    models/ (found automatically by BundledModelProvider) and are also what NuGetModelProvider
    downloads on demand. Models: Copyright Google LLC, Apache-2.0 (converted from MediaPipe TFLite).
  -->
  <PropertyGroup>
    <Description>Selfie segmentation model for MediaPipe.NET (person/background mask). Converted from Google MediaPipe (Apache-2.0) and cross-validated against TFLite. Created by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);models</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(ModelsOnnxDir)selfie_segmenter.onnx" Link="models\selfie_segmenter.onnx" Pack="true" PackagePath="contentFiles/any/any/models/" PackageCopyToOutput="true" BuildAction="None" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/Package.targets" />

</Project>
