<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Content-only model package. The ONNX files land in the consuming application's output folder under
    models/ (found automatically by BundledModelProvider) and are also what NuGetModelProvider
    downloads on demand. Models: Copyright Google LLC, Apache-2.0 (converted from MediaPipe TFLite).
  -->
  <PropertyGroup>
    <Description>Face stylizer model for MediaPipe.NET: BlazeFaceStylizer color sketch (256x256) and the 192x192 face mesh it aligns faces with. Converted from Google MediaPipe (Apache-2.0) and cross-validated against TFLite. Created by Gravicode Studios, led by Kang Fadhil.</Description>
    <PackageTags>$(PackageTags);models</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128;NU5100</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(ModelsOnnxDir)face_stylizer_color_sketch.onnx" Link="models\face_stylizer_color_sketch.onnx" Pack="true" PackagePath="contentFiles/any/any/models/" PackageCopyToOutput="true" BuildAction="None" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ModelsOnnxDir)face_landmarks_detector_192.onnx" Link="models\face_landmarks_detector_192.onnx" Pack="true" PackagePath="contentFiles/any/any/models/" PackageCopyToOutput="true" BuildAction="None" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="$(RepoRoot)build/Package.targets" />

</Project>
