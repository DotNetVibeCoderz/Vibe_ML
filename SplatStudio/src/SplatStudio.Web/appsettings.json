{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/splatstudio.db",
    "SqlServer": "Server=localhost;Database=SplatStudio;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;",
    "MySql": "Server=localhost;Port=3306;Database=splatstudio;User=root;Password=root;"
  },

  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "RootPath": "App_Data/storage",
      "PublicBasePath": "/media"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "splatstudio"
    },
    "S3": {
      "ServiceUrl": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "splatstudio",
      "Region": "us-east-1",
      "ForcePathStyle": false,
      "PublicBaseUrl": ""
    },
    "MinIO": {
      "ServiceUrl": "http://localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "splatstudio",
      "ForcePathStyle": true,
      "PublicBaseUrl": ""
    }
  },

  "Splatting": {
    "Engine": "Gpu",
    "MaxPoints": 40000,
    "GpuMaxPoints": 250000,
    "ExternalApi": {
      "Endpoint": "",
      "ApiKey": "",
      "TimeoutSeconds": 120
    },
    "Hosted": {
      "Photoreal": {
        "ProviderName": "photorealistic 3DGS provider",
        "BaseUrl": "",
        "ApiKey": "",
        "SubmitPath": "/v1/generate",
        "ImageFieldName": "image",
        "SubmitFields": {},
        "JobIdPath": "job_id",
        "StatusPath": "/v1/generate/{jobId}",
        "StatusFieldPath": "status",
        "ResultUrlPath": "result.url",
        "ErrorMessagePath": "error",
        "PollIntervalSeconds": 3,
        "TimeoutSeconds": 900
      },
      "Mesh": {
        "ProviderName": "image-to-3D provider",
        "BaseUrl": "",
        "ApiKey": "",
        "SubmitPath": "/v1/generate",
        "ImageFieldName": "image",
        "SubmitFields": {},
        "JobIdPath": "job_id",
        "StatusPath": "/v1/generate/{jobId}",
        "StatusFieldPath": "status",
        "ResultUrlPath": "result.url",
        "ErrorMessagePath": "error",
        "PollIntervalSeconds": 5,
        "TimeoutSeconds": 900
      }
    }
  },

  "Email": {
    "Provider": "File",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "no-reply@splatstudio.local",
      "FromName": "SplatStudio"
    }
  }
}
