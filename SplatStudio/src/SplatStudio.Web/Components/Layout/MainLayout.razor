@inherits LayoutComponentBase

<div class="app-shell">
    @* A single fixed wash in the depth-ramp colours. It replaced three animated blobs and
       a starfield: with a live point cloud in the hero, moving decoration behind it was
       competing with the actual subject. *@
    <div class="depth-wash" aria-hidden="true"></div>

    <NavMenu />

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <p>
            SplatStudio bakes one photo into a point cloud using a depth heuristic, not
            multi-view reconstruction. <a href="/about">What that means</a>.
        </p>
    </footer>
</div>
