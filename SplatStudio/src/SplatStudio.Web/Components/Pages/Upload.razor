@page "/upload"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using SplatStudio.Infrastructure.Data
@inject ApplicationDbContext Db
@inject IStorageService Storage
@inject IImageProcessingService ImageProcessor
@inject IConversionQueue Queue
@inject IConversionEngineCatalog Engines
@inject NavigationManager Nav
@inject ILogger<Upload> Logger

<PageTitle>SplatStudio &mdash; Upload</PageTitle>

<section class="page-section">
    <div class="glass-panel form-panel">
        <h1>Upload an image</h1>
        <p class="muted">JPEG or PNG, up to 15&nbsp;MB. Photos with one clear subject &mdash; a portrait, an object on a plain background &mdash; work best in every mode.</p>

        <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="upload-form">
            <DataAnnotationsValidator />

            <label class="field-label" for="title">Title</label>
            <InputText id="title" class="text-input" @bind-Value="_form.Title" maxlength="120" placeholder="e.g. My desk plant" />

            <label class="field-label" for="description">Description (optional)</label>
            <InputTextArea id="description" class="text-input" @bind-Value="_form.Description" rows="3" maxlength="500" />

            @* Modes differ in what they produce, what they cost and how long they take, so
               each option states all three rather than just naming itself. Unconfigured
               modes stay visible but disabled — hiding them would leave no clue the
               capability exists or what enabling it takes. *@
            <fieldset class="mode-picker">
                <legend class="field-label">Convert to</legend>

                @foreach (var engine in Engines.Engines)
                {
                    var id = $"mode-{engine.Mode}";
                    var unavailable = !engine.IsAvailable;

                    <label class="mode-option @(unavailable ? "mode-option-disabled" : "")"
                           for="@id"
                           title="@engine.UnavailableReason">
                        <input type="radio"
                               id="@id"
                               name="conversion-mode"
                               disabled="@unavailable"
                               checked="@(_form.Mode == engine.Mode)"
                               @onchange="@(() => _form.Mode = engine.Mode)" />
                        <span class="mode-option-body">
                            <span class="mode-option-head">
                                <span class="mode-option-name">@engine.DisplayName</span>
                                <span class="chip">@ModeBadge(engine.Mode)</span>
                            </span>
                            <span class="mode-option-desc">@engine.Description</span>
                            @if (unavailable)
                            {
                                <span class="mode-option-reason">@engine.UnavailableReason</span>
                            }
                        </span>
                    </label>
                }
            </fieldset>

            <label class="field-label">Visibility</label>
            <div class="visibility-toggle">
                <label><InputCheckbox @bind-Value="_form.IsPublic" /> Public &mdash; visible in the gallery</label>
            </div>

            <label class="field-label" for="file">Image</label>
            <InputFile id="file" OnChange="OnFileSelected" accept=".jpg,.jpeg,.png,.webp" />

            @if (!string.IsNullOrEmpty(_fileError))
            {
                <p class="form-error">@_fileError</p>
            }
            @if (_previewDataUrl is not null)
            {
                <img class="upload-preview" src="@_previewDataUrl" alt="Preview" />
            }

            <button class="btn btn-primary" type="submit" disabled="@(_uploading || _selectedFile is null)">
                @(_uploading ? "Uploading\u2026" : "Start conversion")
            </button>
            @if (SelectedEngine is { Mode: not ConversionMode.HeuristicSplat })
            {
                <p class="muted small mode-timing-note">
                    Hosted conversions run for a few minutes. You can leave this page &mdash; the
                    scene updates itself when it finishes.
                </p>
            }
        </EditForm>
    </div>
</section>

@code {
    private const long MaxFileBytes = 15 * 1024 * 1024;

    private readonly UploadFormModel _form = new();
    private IBrowserFile? _selectedFile;
    private string? _previewDataUrl;
    private string? _fileError;
    private bool _uploading;

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private IConversionEngine? SelectedEngine => Engines.Resolve(_form.Mode);

    protected override void OnInitialized()
    {
        // Default to the first mode this deployment can actually run, so the form never
        // starts on an option the visitor cannot submit.
        var firstAvailable = Engines.Engines.FirstOrDefault(e => e.IsAvailable);
        if (firstAvailable is not null) _form.Mode = firstAvailable.Mode;
    }

    private static string ModeBadge(ConversionMode mode) => mode switch
    {
        ConversionMode.HeuristicSplat => "instant · free",
        ConversionMode.PhotorealSplat => "minutes · hosted",
        ConversionMode.Mesh => "minutes · hosted",
        _ => ""
    };

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        _previewDataUrl = null;
        var file = e.File;

        if (file.Size > MaxFileBytes)
        {
            _fileError = "File is too large (max 15 MB).";
            _selectedFile = null;
            return;
        }

        _selectedFile = file;
        if (string.IsNullOrWhiteSpace(_form.Title))
            _form.Title = Path.GetFileNameWithoutExtension(file.Name);

        using var ms = new MemoryStream();
        await using var stream = file.OpenReadStream(MaxFileBytes);
        await stream.CopyToAsync(ms);
        _previewDataUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task SubmitAsync()
    {
        if (_selectedFile is null || AuthStateTask is null) return;

        // Re-check rather than trusting the disabled attribute: the picker is client-side and
        // configuration could have changed since the page rendered.
        var engine = SelectedEngine;
        if (engine is null || !engine.IsAvailable)
        {
            _fileError = engine?.UnavailableReason ?? "That conversion mode is not available.";
            return;
        }

        _uploading = true;
        try
        {
            var authState = await AuthStateTask;
            var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrEmpty(userId)) return;

            using var uploadMs = new MemoryStream();
            await using (var readStream = _selectedFile.OpenReadStream(MaxFileBytes))
            {
                await readStream.CopyToAsync(uploadMs);
            }
            uploadMs.Position = 0;

            var processed = await ImageProcessor.ProcessUploadAsync(uploadMs, thumbnailMaxDimension: 480);

            var imageAsset = new ImageAsset
            {
                UserId = userId,
                OriginalFileName = _selectedFile.Name,
                ContentType = _selectedFile.ContentType is { Length: > 0 } ct ? ct : "image/jpeg",
                SizeBytes = _selectedFile.Size,
                Width = processed.Width,
                Height = processed.Height
            };
            imageAsset.StorageKey = $"images/{userId}/{imageAsset.Id}{Path.GetExtension(_selectedFile.Name)}";
            imageAsset.ThumbnailStorageKey = $"thumbnails/{userId}/{imageAsset.Id}.jpg";

            uploadMs.Position = 0;
            await Storage.SaveAsync(imageAsset.StorageKey, uploadMs, imageAsset.ContentType);
            using (var thumbStream = new MemoryStream(processed.ThumbnailBytes))
            {
                await Storage.SaveAsync(imageAsset.ThumbnailStorageKey, thumbStream, processed.ThumbnailContentType);
            }

            var scene = new SplatScene
            {
                ImageAssetId = imageAsset.Id,
                UserId = userId,
                Title = string.IsNullOrWhiteSpace(_form.Title) ? _selectedFile.Name : _form.Title,
                Description = _form.Description,
                IsPublic = _form.IsPublic,
                Status = SplatStatus.Queued,
                Mode = _form.Mode,
                // Provisional: the worker sets the real value from what the engine returns.
                ArtifactKind = _form.Mode == ConversionMode.Mesh
                    ? ConversionArtifactKind.Mesh
                    : ConversionArtifactKind.Splat
            };

            Db.ImageAssets.Add(imageAsset);
            Db.SplatScenes.Add(scene);
            await Db.SaveChangesAsync();

            Queue.QueueSceneConversion(scene.Id);

            Nav.NavigateTo($"scenes/{scene.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Upload failed");
            _fileError = "Something went wrong while uploading. Please try again.";
        }
        finally
        {
            _uploading = false;
        }
    }

    private class UploadFormModel
    {
        [System.ComponentModel.DataAnnotations.Required, System.ComponentModel.DataAnnotations.StringLength(120)]
        public string Title { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.StringLength(500)]
        public string? Description { get; set; }

        public bool IsPublic { get; set; } = true;

        public ConversionMode Mode { get; set; } = ConversionMode.HeuristicSplat;
    }
}
