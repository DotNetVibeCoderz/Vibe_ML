@* A single floating glass card in the gallery's "constellation grid". Purely
   presentational — the parent page resolves the thumbnail URL via
   IStorageService and passes it in, so this component has no infrastructure
   dependencies. *@

<a class="scene-card glass-panel" href="@($"scenes/{Scene.Id}")">
    <div class="scene-card-thumb">
        @if (!string.IsNullOrEmpty(ThumbnailUrl))
        {
            <img src="@ThumbnailUrl" alt="@Scene.Title" loading="lazy" />
        }
        else
        {
            <div class="scene-card-thumb-placeholder" aria-hidden="true"></div>
        }
        <span class="scene-card-status status-@Scene.Status.ToString().ToLowerInvariant()">
            @Scene.Status
        </span>
    </div>

    <div class="scene-card-body">
        <h3 class="scene-card-title">@Scene.Title</h3>
        <div class="scene-card-meta">
            <StarRating Value="@Scene.AverageRating" Count="@Scene.Ratings.Count" />
            <span class="scene-card-points" title="Gaussian splat count">@Scene.PointCount.ToString("N0") pts</span>
        </div>
        <div class="scene-card-footer">
            <span>@Scene.ViewCount views</span>
            <span>@Scene.Comments.Count comments</span>
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public SplatScene Scene { get; set; } = null!;
    [Parameter] public string? ThumbnailUrl { get; set; }
}
