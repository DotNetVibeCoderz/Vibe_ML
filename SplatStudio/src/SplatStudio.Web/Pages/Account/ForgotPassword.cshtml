@page
@model SplatStudio.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Forgot password"; }

@if (Model.EmailSent)
{
    <h1>Check your email</h1>
    <p class="muted">If an account exists for that address, we've sent a link to reset your password.</p>
    @if (Model.DebugResetLink is not null)
    {
        <p class="muted small">Dev mode (File email provider): <a href="@Model.DebugResetLink">@Model.DebugResetLink</a></p>
    }
    <a class="btn btn-primary" href="Login">Back to sign in</a>
}
else
{
    <h1>Forgot your password?</h1>
    <p class="muted">Enter your email and we'll send you a reset link.</p>

    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="form-error"></div>

        <label class="field-label" asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" class="text-input" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="form-error"></span>

        <button class="btn btn-primary" type="submit">Send reset link</button>
    </form>
}
