@page
@model SplatStudio.Web.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }

<h1>Sign in</h1>
<p class="muted">New here? <a href="Register">Create an account</a>.</p>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="form-error"></div>

    <label class="field-label" asp-for="Input.Email">Email</label>
    <input asp-for="Input.Email" class="text-input" autocomplete="username" />
    <span asp-validation-for="Input.Email" class="form-error"></span>

    <label class="field-label" asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" class="text-input" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="form-error"></span>

    <label class="visibility-toggle">
        <input asp-for="Input.RememberMe" />
        Remember me
    </label>

    <button class="btn btn-primary" type="submit">Sign in</button>
    <p class="muted small"><a href="ForgotPassword">Forgot your password?</a></p>
</form>
