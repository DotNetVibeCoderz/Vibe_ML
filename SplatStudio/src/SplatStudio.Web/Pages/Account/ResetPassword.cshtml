@page
@model SplatStudio.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Reset password"; }

@if (Model.Completed)
{
    <h1>Password updated</h1>
    <p class="muted">You can now sign in with your new password.</p>
    <a class="btn btn-primary" href="Login">Sign in</a>
}
else
{
    <h1>Choose a new password</h1>

    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="form-error"></div>
        <input type="hidden" asp-for="Input.Code" />
        <input type="hidden" asp-for="Input.Email" />

        <label class="field-label" asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" class="text-input" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword" class="form-error"></span>

        <label class="field-label" asp-for="Input.ConfirmPassword">Confirm new password</label>
        <input asp-for="Input.ConfirmPassword" class="text-input" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="form-error"></span>

        <button class="btn btn-primary" type="submit">Reset password</button>
    </form>
}
