<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styling for HF Gallery. Everything here reads from Tokens.axaml, so the two themes
    differ only in that file.
  -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppGround}" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBaseBrush}" />
  </Style>

  <!-- The eyebrow: small, wide-tracked, muted. Used for section names, never for content. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="{DynamicResource FontMicro}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="LetterSpacing" Value="1.4" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontLarge}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
  </Style>

  <!-- ==================================================================== rail -->

  <Style Selector="ListBox.rail">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBox.rail ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
  </Style>

  <Style Selector="ListBox.rail ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverGround}" />
  </Style>

  <Style Selector="ListBox.rail ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedGround}" />
  </Style>

  <!--
    The offset bar: the selected row grows a solid amber edge on its left. Carried over from
    HFAppGen deliberately - the gallery and the IDE are one product, and the selection marker is
    the piece of that identity that shows up on every screen of both.
  -->
  <Style Selector="ListBox.rail ListBoxItem Border#Marker">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBox.rail ListBoxItem:selected Border#Marker">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="ListBox.rail ListBoxItem:selected TextBlock.railTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
  </Style>

  <!-- ==================================================================== input -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource RaisedGround}" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectedGround}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource RaisedGround}" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#1A1207" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="#1A1207" />
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ==================================================================== panels -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource RaisedGround}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSmall}" />
    <Setter Property="Padding" Value="7,3" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
