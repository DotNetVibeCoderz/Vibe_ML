<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gravicode.HFNet.GraviTransformers</RootNamespace>
    <AssemblyName>Gravicode.HFNet.GraviTransformers</AssemblyName>
    <PackageId>Gravicode.HFNet.GraviTransformers</PackageId>
    <Description>GraviTransformers - run Hugging Face transformer models on .NET: load pretrained BERT-family encoders and GPT-2/Llama/Mistral/Qwen/Pythia decoders from safetensors or PyTorch weights and serve them through task pipelines - classification, fill-mask, named entities, question answering, embeddings and text generation. ViT and CLIP are in Gravicode.HFNet.GraviTransformers.Vision. Part of HF.Net. Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Softmax is internal and is pinned against overflow; the tests reach it directly because a
         NaN there only shows up as a model that silently predicts nothing. -->
    <InternalsVisibleTo Include="GraviTransformers.Tests" />

    <!-- GraviPEFT trains adapters through these same kernels, so the function it differentiates is
         the function inference runs. The two packages are versioned and released together. -->
    <InternalsVisibleTo Include="Gravicode.HFNet.GraviPEFT" />
    <InternalsVisibleTo Include="GraviPEFT.Tests" />

    <!-- The per-library benchmarks time the GEMM directly against the foundation and ILGPU. -->
    <InternalsVisibleTo Include="HFNet.Benchmarks" />

    <!-- ViT and CLIP live in GraviTransformers.Vision (so text users skip ImageSharp) but run on these
         same kernels. -->
    <InternalsVisibleTo Include="Gravicode.HFNet.GraviTransformers.Vision" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Gravicode.Science.GraviNum" />
    <PackageReference Include="Gravicode.Science.GraviFrame" />
    <PackageReference Include="Gravicode.Science.GraviLearn" />
    <PackageReference Include="Gravicode.Science.GraviText" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GraviHub\GraviHub.csproj" />
    <ProjectReference Include="..\GraviTokenizers\GraviTokenizers.csproj" />
  </ItemGroup>

</Project>
