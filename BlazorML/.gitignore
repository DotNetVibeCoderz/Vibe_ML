# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
*.user
*.suo

# The workspace the app creates at runtime: the SQLite database, uploaded datasets, and saved
# models. Data, not source — and it can grow large.
App_Data/
**/App_Data/

# Credentials must never be committed. Provider API keys belong in user secrets
# (`dotnet user-secrets set "Chat:OpenAI:ApiKey" "..."`) or in environment variables, both of
# which override appsettings.json without touching it. `ShippedSettingsTests` fails the build if
# a key finds its way back into the committed file.
appsettings.*.local.json
appsettings.Production.json
secrets.json
*.pfx
*.key

# Test and tooling artefacts
TestResults/
.playwright/
playwright-report/
*.trx
*.coverage

# Editors
.vs/
.vscode/
.idea/
*.swp
.DS_Store
