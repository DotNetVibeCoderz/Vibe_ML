{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Workspace": {
    "Name": "Blazor ML Studio",
    "Tagline": "Rancang, latih, dan terbitkan model tanpa menulis kode.",
    "DefaultLanguage": "id",
    "DefaultTheme": "system",
    "AllowRegistration": true,
    "BuiltBy": "Gravicode Studios",
    "LedBy": "Kang Fadhil"
  },

  "Database": {
    "Provider": "Sqlite",
    "ConnectionStrings": {
      "Sqlite": "Data Source=App_Data/blazorml.db",
      "SqlServer": "Server=localhost;Database=BlazorML;Trusted_Connection=True;TrustServerCertificate=True",
      "MySql": "Server=localhost;Database=blazorml;User=root;Password=",
      "PostgreSql": "Host=localhost;Database=blazorml;Username=postgres;Password="
    },
    "SeedSampleData": true,
    "CommandTimeoutSeconds": 60
  },

  "Storage": {
    "Provider": "FileSystem",
    "MaxUploadMegabytes": 256,
    "FileSystem": { "RootPath": "App_Data/storage" },
    "AzureBlob": { "ConnectionString": "", "Container": "blazorml" },
    "S3": { "AccessKey": "", "SecretKey": "", "Bucket": "blazorml", "Region": "us-east-1", "ServiceUrl": "", "ForcePathStyle": false },
    "MinIO": { "AccessKey": "", "SecretKey": "", "Bucket": "blazorml", "Region": "us-east-1", "ServiceUrl": "http://localhost:9000", "ForcePathStyle": true }
  },

  "Chat": {
    "Enabled": true,
    "AssistantName": "Profesor Wicak",
    "Provider": "OpenAI",
    "Temperature": 0.4,
    "MaxTokens": 4096,
    "HistoryTurns": 12,
    "EnableFunctionCalling": true,
    "StreamResponses": true,
    "OpenAI": { "ApiKey": "", "Model": "gpt-4o-mini" },
    "Anthropic": { "ApiKey": "", "Model": "claude-sonnet-4-5" },
    "Gemini": { "ApiKey": "", "Model": "gemini-2.0-flash" },
    "Ollama": { "Enabled": false, "Endpoint": "http://localhost:11434", "Model": "llama3.2" }
  },

  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Blazor ML Studio",
    "ResetLinkValidHours": 2
  },

  "Tools": {
    "TavilyApiKey": "",
    "EnableWebSearch": true,
    "EnableUrlScraping": true,
    "WebRequestTimeoutSeconds": 30,
    "MaxSearchResults": 5
  },

  "Training": {
    "MaxConcurrentRuns": 2,
    "DefaultAutoMlSeconds": 60,
    "RunTimeoutMinutes": 30,
    "PreviewRows": 10,
    "MaxRowsInMemory": 1000000
  },

  "Scripting": {
    "EnablePython": true,
    "EnableR": false,
    "EnableCSharp": true,
    "EnableJavaScript": true,
    "PythonDll": "",
    "RscriptPath": "Rscript",
    "DefaultTimeoutSeconds": 120
  }
}
