@* Metric readout. Mono and right-aligned so the decimal points line up and two runs can be
   compared by eye without reading every digit. *@

<dl class="metrics">
    @foreach (var (name, value) in Values.OrderBy(v => Rank(v.Key)))
    {
        <div class="metric">
            <dt>@Humanise(name)</dt>
            <dd class="num">@Format(name, value)</dd>
        </div>
    }
</dl>

@code {
    [Parameter, EditorRequired] public Dictionary<string, double> Values { get; set; } = [];

    /// <summary>Headline metrics first, so the number that matters is not buried.</summary>
    private static int Rank(string name) => name switch
    {
        "AUC" => 0,
        "Accuracy" or "MacroAccuracy" => 1,
        "RSquared" => 1,
        "F1" => 2,
        "Precision" or "MicroAccuracy" => 3,
        "Recall" => 4,
        "RootMeanSquaredError" => 5,
        _ => 9
    };

    private static string Humanise(string name) => name switch
    {
        "AUC" => "AUC",
        "Accuracy" => "Akurasi",
        "MacroAccuracy" => "Akurasi makro",
        "MicroAccuracy" => "Akurasi mikro",
        "Precision" => "Presisi",
        "Recall" => "Recall",
        "F1" => "F1",
        "Specificity" => "Spesifisitas",
        "RSquared" => "R²",
        "MeanAbsoluteError" => "MAE",
        "MeanSquaredError" => "MSE",
        "RootMeanSquaredError" => "RMSE",
        "Clusters" => "Jumlah klaster",
        "Balance" => "Keseimbangan klaster",
        _ => name
    };

    private static string Format(string name, double value)
    {
        if (double.IsNaN(value))
        {
            return "—";
        }

        // Counts are integers; everything else is a score or an error term where four places
        // is enough to tell two runs apart.
        return name is "Clusters" or "Classes" or "LargestCluster" or "SmallestCluster" or "FlaggedAtP95"
            ? value.ToString("N0")
            : value.ToString("N4");
    }
}
