@inject IConfiguration Configuration

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <title>Blazor ML Studio</title>
    <meta name="description" content="Rancang, latih, dan terbitkan model machine learning tanpa menulis kode." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["designer.css"]" />
    <link rel="stylesheet" href="@Assets["chat.css"]" />
    <link rel="stylesheet" href="@Assets["BlazorML.Web.styles.css"]" />

    <link rel="icon" type="image/png" href="favicon.png" />

    @* Applies the stored theme before first paint. Without this the page renders in the
       default theme and then snaps to the user's choice, which reads as a bug. *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('blazorml-theme');
                if (stored === 'light' || stored === 'dark') {
                    document.documentElement.setAttribute('data-theme', stored);
                }
            } catch (e) {
                /* Private browsing blocks localStorage; the media query still applies. */
            }
        })();
    </script>

    <HeadOutlet />
</head>
<body>
    <Routes />

    <div id="blazor-error-ui" data-nosnippet>
        Koneksi ke server terputus.
        <a href="." class="reload">Muat ulang</a>
        <span class="dismiss">&times;</span>
    </div>

    <script src="lib/d3/d3.min.js"></script>
    <script src="js/designer.js"></script>
    <script src="js/charts.js"></script>
    <script src="js/app.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
