<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A team runs in-process rather than through the HTTP API. Its members share one loaded model
      and one session manager, so going over HTTP would mean several clients contending for the
      same weights through a hop that buys nothing.
    -->
    <ProjectReference Include="..\..\src\LocalGen.Kernel\LocalGen.Kernel.csproj" />
    <ProjectReference Include="..\..\src\LocalGen.Runtime\LocalGen.Runtime.csproj" />
    <ProjectReference Include="..\..\src\LocalGen.Engines.LlamaSharp\LocalGen.Engines.LlamaSharp.csproj" />
  </ItemGroup>

</Project>
