      RAG runs in-process rather than through the HTTP API: ingestion embeds every chunk with a
      locally loaded model, so it belongs in the same process as the runtime.
    -->
    <ProjectReference Include="..\..\src\LocalGen.Rag\LocalGen.Rag.csproj" />
    <ProjectReference Include="..\..\src\LocalGen.Runtime\LocalGen.Runtime.csproj" />
    <ProjectReference Include="..\..\src\LocalGen.Engines.LlamaSharp\LocalGen.Engines.LlamaSharp.csproj" />
    <ProjectReference Include="..\..\src\LocalGen.Sdk\LocalGen.Sdk.csproj" />
  </ItemGroup>

</Project>
