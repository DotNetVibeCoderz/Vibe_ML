<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniaEmbedded.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <SolidColorBrush x:Key="Surface" Color="#12151A" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1A1F26" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0D1014" />
    <SolidColorBrush x:Key="Edge" Color="#262C35" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A8391" />
    <SolidColorBrush x:Key="Signal" Color="#F5A524" />
    <SolidColorBrush x:Key="Data" Color="#2DD4BF" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>
  </Application.Styles>

</Application>
