<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:AvaloniaEmbedded"
        xmlns:models="using:LocalGen.Core.Models"
        mc:Ignorable="d"
        x:Class="AvaloniaEmbedded.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="LocalGen — embedded runtime"
        Width="900" Height="680"
        MinWidth="540" MinHeight="400"
        Background="{DynamicResource Surface}">

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <Border Grid.Row="0" Padding="14,10"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
        <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center" />

        <ComboBox Grid.Column="1" ItemsSource="{Binding Models}"
                  SelectedItem="{Binding SelectedModel}" MinWidth="280">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:ModelDescriptor">
              <TextBlock Classes="mono" Text="{Binding Id}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Grid.Column="2" Classes="mono muted" Text="{Binding Status}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="14">
      <ItemsControl ItemsSource="{Binding Turns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:Turn">
            <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="5" MaxWidth="640"
                    HorizontalAlignment="{Binding Alignment}"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1">
              <StackPanel Spacing="3">
                <TextBlock Classes="mono muted" FontSize="11" Text="{Binding Speaker}" />
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Throughput is worth showing here: with the model in-process, this is the machine's
         own speed with nothing between the app and the weights. -->
    <TextBlock Grid.Row="2" Classes="mono" Margin="14,0,14,6"
               Foreground="{DynamicResource Data}"
               Text="{Binding Statistics}" />

    <Border Grid.Row="3" Padding="14"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBox Grid.Column="0" Text="{Binding Prompt}"
                 Watermark="Ask something — the model runs inside this process"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />

        <Button Grid.Column="1" Content="Send" MinWidth="84"
                Background="{DynamicResource Signal}" Foreground="#12151A"
                Command="{Binding SendCommand}"
                IsVisible="{Binding !IsGenerating}" />

        <Button Grid.Column="1" Content="Stop" MinWidth="84"
                Command="{Binding StopCommand}"
                IsVisible="{Binding IsGenerating}" />

        <Button Grid.Column="2" Content="Clear" Command="{Binding ClearCommand}" />
      </Grid>
    </Border>
  </Grid>
</Window>
