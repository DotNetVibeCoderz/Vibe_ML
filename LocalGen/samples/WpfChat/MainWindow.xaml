<Window x:Class="WpfChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalGen — WPF sample"
        Height="640" Width="880"
        MinHeight="380" MinWidth="520"
        Background="{StaticResource Surface}">

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Model bar -->
    <Border Grid.Row="0" Padding="14,10" Background="{StaticResource SurfaceSunken}"
            BorderBrush="{StaticResource Edge}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center" Margin="0,0,10,0" />

        <ComboBox Grid.Column="1" x:Name="ModelPicker" MaxWidth="360"
                  HorizontalAlignment="Left" VerticalAlignment="Center" />

        <TextBlock Grid.Column="2" x:Name="StatusText" Text="connecting…"
                   Foreground="{StaticResource TextMuted}"
                   FontFamily="Consolas" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Transcript -->
    <ScrollViewer Grid.Row="1" x:Name="TranscriptScroller"
                  VerticalScrollBarVisibility="Auto" Padding="14">
      <ItemsControl x:Name="Transcript">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="5" MaxWidth="640"
                    HorizontalAlignment="{Binding Alignment}"
                    Background="{StaticResource SurfaceRaised}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,3" />
                <TextBlock Text="{Binding Text}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Composer -->
    <Border Grid.Row="2" Padding="14" Background="{StaticResource SurfaceSunken}"
            BorderBrush="{StaticResource Edge}" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBox Grid.Column="0" x:Name="PromptBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 KeyDown="OnPromptKeyDown" />

        <Button Grid.Column="1" x:Name="SendButton" Content="Send"
                Margin="10,0,0,0" MinWidth="86" Click="OnSendClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
