<Application x:Class="WpfChat.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- A dark palette matching LocalGen's own, so the sample looks like part of the product. -->
    <SolidColorBrush x:Key="Surface" Color="#12151A" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1A1F26" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0D1014" />
    <SolidColorBrush x:Key="Edge" Color="#262C35" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
    <SolidColorBrush x:Key="TextMuted" Color="#7A8391" />
    <SolidColorBrush x:Key="Signal" Color="#F5A524" />
    <SolidColorBrush x:Key="Data" Color="#2DD4BF" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
      <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Signal}" />
      <Setter Property="Foreground" Value="#12151A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
    </Style>

  </Application.Resources>
</Application>
