@inherits LayoutComponentBase
@inject LocalGenClient Client
@inject IJSRuntime Js
@implements IDisposable

@*
    The shell carries the same readout strip as the desktop Admin Control: service reachability
    and the resident model stay on screen wherever you navigate, because the point of running
    locally is that the machine is not hidden from you.
*@

<div class="shell">

    <header class="readout-strip">
        <div class="brand">
            <span class="brand-mark">L</span>
            <span>LocalGen</span>
        </div>

        <div class="strip-status">
            <span class="led @(_online ? "online" : "offline")"></span>
            <span class="mono">@(_online ? "connected" : "unreachable")</span>
            <span class="mono muted">@_endpoint</span>
        </div>

        <div class="strip-metrics">
            <div class="metric">
                <span class="eyebrow">Models</span>
                <span class="value">@_modelCount</span>
            </div>
            <div class="metric">
                <span class="eyebrow">Loaded</span>
                <span class="value data">@(_loadedModel ?? "—")</span>
            </div>
            <button class="ghost" @onclick="ToggleThemeAsync" title="Switch between light and dark">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4.5" />
                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19" />
                </svg>
            </button>
        </div>
    </header>

    <div class="body">
        <nav class="rail">
            <NavLink href="" Match="NavLinkMatch.All">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 5h16v11H10l-4.5 4v-4H4z" />
                </svg>
                Chat
            </NavLink>
            <NavLink href="models">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l9 5-9 5-9-5z M3 12.5l9 5 9-5 M3 16.5l9 5 9-5" />
                </svg>
                Models
            </NavLink>
            <NavLink href="analytics">
                <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12h4l2.5-7L14 19l2.5-7H21" />
                </svg>
                Analytics
            </NavLink>

            <div class="version mono muted">v@_version</div>
        </nav>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cancellation = new();
    private PeriodicTimer? _timer;

    private bool _online;
    private string _endpoint = string.Empty;
    private int _modelCount;
    private string? _loadedModel;

    private readonly string _version =
        typeof(MainLayout).Assembly.GetName().Version?.ToString(3) ?? "0.1.0";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();

        // Polling keeps the strip honest when the server is started or stopped elsewhere —
        // from the desktop app, or from `localgen serve` in a terminal.
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cancellation.Token))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The circuit went away; nothing to clean up beyond the timer.
        }
    }

    private async Task RefreshAsync()
    {
        _online = await Client.PingAsync(_cancellation.Token);

        if (!_online)
        {
            _modelCount = 0;
            _loadedModel = null;
            return;
        }

        try
        {
            var status = await Client.Admin.GetStatusAsync(_cancellation.Token);

            _endpoint = status.BaseUrl;
            _loadedModel = status.LoadedModels.FirstOrDefault()?.Id;
            _modelCount = (await Client.ListModelsAsync(_cancellation.Token)).Count;
        }
        catch (LocalGenClientException)
        {
            _online = false;
        }
    }

    private async Task ToggleThemeAsync() => await Js.InvokeVoidAsync("localgenTheme.toggle");

    public void Dispose()
    {
        _cancellation.Cancel();
        _timer?.Dispose();
        _cancellation.Dispose();
    }
}
