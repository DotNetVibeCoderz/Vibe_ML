<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      .NET client SDK for LocalGen. Works against any LocalGen server — or any OpenAI-compatible
      endpoint — from console, web, desktop and IoT applications.
    </Description>
    <PackageId>LocalGen.Sdk</PackageId>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalGen.Core\LocalGen.Core.csproj" />
  </ItemGroup>

</Project>
