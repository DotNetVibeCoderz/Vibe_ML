<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalGen.Desktop.ViewModels"
             mc:Ignorable="d"
             x:Class="LocalGen.Desktop.Views.EngineView"
             x:DataType="vm:EngineViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="18" MaxWidth="1000" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Classes="eyebrow" Text="INFERENCE BACKEND" />
        <TextBlock Classes="display" Text="How LocalGen uses this machine" />
        <TextBlock Classes="secondary" MaxWidth="640" HorizontalAlignment="Left"
                   Text="Backend choice has the largest single effect on speed. LocalGen probes what is actually installed and says what it would pick." />
      </StackPanel>

      <!-- The recommendation leads, because most users have no basis to choose otherwise. -->
      <Border Classes="panel"
              Background="{DynamicResource SignalWash}"
              BorderBrush="{DynamicResource SignalDim}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Classes="eyebrow" Text="RECOMMENDED HERE"
                       Foreground="{DynamicResource Signal}" />
            <TextBlock Classes="title" Text="{Binding RecommendationHeadline}"
                       Foreground="{DynamicResource Signal}" />
            <TextBlock Classes="secondary" Text="{Binding RecommendationRationale}"
                       TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left" />
          </StackPanel>

          <Button Grid.Column="1" Classes="primary" Content="Use this"
                  VerticalAlignment="Center"
                  Command="{Binding UseRecommendedCommand}" />
        </Grid>
      </Border>

      <!-- Backends -->
      <ItemsControl ItemsSource="{Binding Engines}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:EngineRow">
            <Border Classes="panel" Margin="0,0,0,10"
                    BorderBrush="{Binding IsSelected, Converter={x:Static vm:Converters.SelectionBorder}}">
              <StackPanel Spacing="12">

                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Ellipse Grid.Column="0" Classes="led"
                           Classes.running="{Binding IsAvailable}"
                           Classes.stopped="{Binding !IsAvailable}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                  <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Classes="heading" Text="{Binding DisplayName}" />
                      <Border Classes="chip" IsVisible="{Binding IsSelected}"
                              Background="{DynamicResource SignalWash}"
                              BorderBrush="{DynamicResource SignalDim}">
                        <TextBlock Text="active" Foreground="{DynamicResource Signal}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="mono muted" Text="{Binding StateLabel}" />
                  </StackPanel>

                  <Button Grid.Column="2" Content="Select" Padding="12,5"
                          IsEnabled="{Binding IsAvailable}"
                          Command="{Binding $parent[ItemsControl].((vm:EngineViewModel)DataContext).SelectCommand}"
                          CommandParameter="{Binding}" />
                </Grid>

                <TextBlock Classes="secondary" Text="{Binding Description}" TextWrapping="Wrap" />

                <TextBlock Classes="mono" Foreground="{DynamicResource Alert}"
                           Text="{Binding UnavailableReason}" TextWrapping="Wrap"
                           IsVisible="{Binding HasReason}" />

                <WrapPanel>
                  <Border Classes="chip" Margin="0,0,5,5">
                    <TextBlock Text="{Binding Devices, StringFormat='devices: {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5">
                    <TextBlock Text="{Binding Formats, StringFormat='formats: {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5" IsVisible="{Binding SupportsGrammar}">
                    <TextBlock Text="grammar" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5" IsVisible="{Binding SupportsEmbeddings}">
                    <TextBlock Text="embeddings" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5" IsVisible="{Binding SupportsMultiGpu}">
                    <TextBlock Text="multi-GPU" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5" IsVisible="{Binding HasAccelerators}">
                    <TextBlock Text="{Binding Accelerators, StringFormat='GPUs: {0}'}" />
                  </Border>
                  <Border Classes="chip" Margin="0,0,5,5" IsVisible="{Binding CanSplit}"
                          Background="{DynamicResource SignalWash}"
                          BorderBrush="{DynamicResource SignalDim}">
                    <TextBlock Text="splittable" Foreground="{DynamicResource Signal}" />
                  </Border>
                </WrapPanel>

                <TextBlock Classes="mono muted" Text="{Binding Build}" TextWrapping="Wrap"
                           IsVisible="{Binding HasBuild}" />

                <TextBlock Classes="mono muted" Text="{Binding Recommendation}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Runtime settings -->
      <Border Classes="panel">
        <StackPanel Spacing="16">
          <TextBlock Classes="heading" Text="Load settings" />

          <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="18" RowSpacing="14">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono muted" Text="Device"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono muted" Text="GPU layers"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <Slider Value="{Binding GpuLayers}" Minimum="0" Maximum="128" Width="260" />
              <TextBlock Classes="mono" VerticalAlignment="Center"
                         Text="{Binding GpuLayers, StringFormat='{}{0} (0 = all)'}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="mono muted" Text="Context size"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <Slider Value="{Binding ContextSize}" Minimum="0" Maximum="131072"
                      TickFrequency="1024" Width="260" />
              <TextBlock Classes="mono" VerticalAlignment="Center"
                         Text="{Binding ContextSize, StringFormat='{}{0:N0} (0 = model default)'}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Classes="mono muted" Text="Threads"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
              <Slider Value="{Binding Threads}" Minimum="0" Maximum="64" Width="260" />
              <TextBlock Classes="mono" VerticalAlignment="Center"
                         Text="{Binding Threads, StringFormat='{}{0} (0 = automatic)'}" />
            </StackPanel>
          </Grid>

          <!--
            The section states what the backend can see whatever that is; the controls appear
            only above one GPU. On a one-GPU machine they would be four fields that cannot change
            anything — but the reason for their absence is the thing a user came here to find out,
            so it is said rather than left as a gap.
          -->
          <Border Classes="panel" Background="{DynamicResource SurfaceSunken}">
            <StackPanel Spacing="14">
              <StackPanel Spacing="4">
                <TextBlock Classes="heading" Text="Across GPUs" />
                <TextBlock Classes="secondary" Text="{Binding AcceleratorSummary}" TextWrapping="Wrap" />
              </StackPanel>

              <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="18" RowSpacing="14"
                    IsVisible="{Binding MultiGpuAvailable}">

                <TextBlock Grid.Row="0" Grid.Column="0" Classes="mono muted" Text="Split mode"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding SplitModes}" SelectedItem="{Binding SplitMode}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="mono muted" Text="Weights per GPU"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                  <TextBox Classes="mono" Width="260" HorizontalAlignment="Left"
                           Watermark="0.6, 0.4" Text="{Binding TensorSplitText}" />
                  <TextBlock Classes="mono" TextWrapping="Wrap" MaxWidth="520"
                             HorizontalAlignment="Left"
                             Text="{Binding SplitPreview}"
                             Foreground="{Binding SplitPreviewIsWarning, Converter={x:Static vm:Converters.WarningOrMuted}}" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="mono muted" Text="Main GPU"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                  <Slider Value="{Binding MainGpu}" Minimum="0" Maximum="7" TickFrequency="1"
                          IsSnapToTickEnabled="True" Width="200" />
                  <TextBlock Classes="mono" VerticalAlignment="Center"
                             Text="{Binding MainGpu, StringFormat='device {0} holds the KV cache'}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Classes="primary" Content="Apply" Command="{Binding ApplyCommand}" />
            <Button Classes="ghost" Content="Re-probe backends" Command="{Binding RefreshCommand}" />
          </StackPanel>

          <TextBlock Classes="mono muted" Text="{Binding SaveHint}" TextWrapping="Wrap"
                     IsVisible="{Binding SaveHint, Converter={x:Static vm:Converters.IsNotEmpty}}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
