<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:LocalGen.Desktop.ViewModels"
        xmlns:ctl="using:LocalGen.Desktop.Controls"
        mc:Ignorable="d"
        x:Class="LocalGen.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="LocalGen Admin Control"
        Width="1280" Height="820"
        MinWidth="940" MinHeight="600"
        Background="{DynamicResource SurfaceBase}"
        TransparencyLevelHint="None">

  <Grid RowDefinitions="Auto,Auto,*">

    <!--
      ─────────────  The readout strip  ─────────────
      Persistent instrument panel: identity on the left, measured state on the right. It is the
      one element allowed to be loud, and it earns that by being the only place the machine's
      live condition is reported.
    -->
    <Border Grid.Row="0"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource Edge}"
            BorderThickness="0,0,0,1"
            Padding="18,0">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="56">

        <!-- Identity -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="22" Height="22"
                  Background="{DynamicResource Signal}"
                  CornerRadius="{DynamicResource RadiusSmall}">
            <TextBlock Text="L"
                       FontFamily="{DynamicResource FontMono}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#12151A"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="LocalGen"
                     FontSize="{DynamicResource TextHeading}"
                     FontWeight="SemiBold"
                     LetterSpacing="-0.2"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Service state -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="24,0,0,0">
          <Ellipse Classes="led" Classes.running="{Binding LedState, Converter={x:Static vm:Converters.EqualsRunning}}"
                   Classes.busy="{Binding LedState, Converter={x:Static vm:Converters.EqualsBusy}}"
                   Classes.faulted="{Binding LedState, Converter={x:Static vm:Converters.EqualsFaulted}}"
                   Classes.stopped="{Binding LedState, Converter={x:Static vm:Converters.EqualsStopped}}"
                   VerticalAlignment="Center" />
          <TextBlock Classes="mono" Text="{Binding ServiceState}" VerticalAlignment="Center" />
          <TextBlock Classes="mono muted" Text="{Binding ServiceAddress}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Live measurements. Mono throughout: every value here is machine-measured. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">

          <StackPanel Spacing="1">
            <TextBlock Classes="eyebrow" Text="MODEL" />
            <TextBlock Classes="mono" Text="{Binding LoadedModelSummary}"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Spacing="1">
            <TextBlock Classes="eyebrow" Text="BACKEND" />
            <TextBlock Classes="mono" Text="{Binding DeviceSummary}" />
          </StackPanel>

          <StackPanel Spacing="1">
            <TextBlock Classes="eyebrow" Text="CONTEXT" />
            <TextBlock Classes="mono" Text="{Binding MemorySummary}" />
          </StackPanel>

          <!-- Throughput: the number and its recent shape, side by side. -->
          <StackPanel Spacing="1" MinWidth="140">
            <TextBlock Classes="eyebrow" Text="THROUGHPUT" />
            <Grid ColumnDefinitions="*,72">
              <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Throughput}"
                         Foreground="{DynamicResource Data}" VerticalAlignment="Center" />
              <ctl:Sparkline Grid.Column="1" Height="16"
                             Values="{Binding ThroughputHistory}"
                             Stroke="{DynamicResource Data}"
                             StrokeThickness="1.5"
                             VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <Button Classes="ghost" Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="Switch between light and dark"
                  Padding="8" VerticalAlignment="Center">
            <Path Width="16" Height="16" Stretch="Uniform"
                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.6"
                  Data="{Binding IsDarkTheme, Converter={x:Static vm:Converters.ThemeGlyph}}" />
          </Button>

        </StackPanel>
      </Grid>
    </Border>

    <!--
      The trace runs edge to edge under the strip, tying the readout to the whole window.
      It stays collapsed until there is something to plot: an empty band would just be a stripe.
    -->
    <ctl:Sparkline Grid.Row="1" Height="34"
                   Values="{Binding ThroughputHistory}"
                   Stroke="{DynamicResource SignalDim}"
                   Fill="{DynamicResource SignalWash}"
                   StrokeThickness="1.2"
                   IsVisible="{Binding ThroughputHistory.Count}" />

    <!-- ─────────────  Rail + content  ───────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="188,*">

      <Border Grid.Column="0"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource Edge}"
              BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom"
                     Classes="mono muted"
                     Text="{Binding Version, StringFormat='v{0}'}"
                     Margin="20,0,0,14" />

          <ListBox Classes="rail"
                   ItemsSource="{Binding Items}"
                   SelectedItem="{Binding SelectedItem}"
                   DockPanel.Dock="Top">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItem">
                <StackPanel Orientation="Horizontal" Spacing="11">
                  <Path Width="17" Height="17" Stretch="Uniform"
                        Stroke="{Binding $parent[ListBoxItem].Foreground}"
                        StrokeThickness="1.5"
                        StrokeLineCap="Round"
                        StrokeJoin="Round"
                        Data="{Binding Glyph}"
                        VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding SelectedItem.Target}" />

    </Grid>
  </Grid>
</Window>
