<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LocalGen.Desktop.ViewModels"
             xmlns:ctl="using:LocalGen.Desktop.Controls"
             mc:Ignorable="d"
             x:Class="LocalGen.Desktop.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Classes="eyebrow" Text="MONITORING" />
          <TextBlock Classes="display" Text="What the machine is doing" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="Refresh now"
                VerticalAlignment="Bottom" Command="{Binding RefreshCommand}" />
      </Grid>

      <!-- Headline figures. Every value here is measured, so every value is mono. -->
      <UniformGrid Columns="4" Margin="0,4,0,0">
        <Border Classes="tile" Margin="0,0,10,0">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="THROUGHPUT" />
            <TextBlock Classes="readout" Text="{Binding AverageThroughput}" />
            <ctl:Sparkline Height="26" Values="{Binding ThroughputTrace}"
                           Stroke="{DynamicResource Data}" StrokeThickness="1.5" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="tile" Margin="0,0,10,0">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="TIME TO FIRST TOKEN" />
            <TextBlock Classes="readout" Text="{Binding AverageLatency}" />
            <ctl:Sparkline Height="26" Values="{Binding LatencyTrace}"
                           Stroke="{DynamicResource Signal}" StrokeThickness="1.5" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="tile" Margin="0,0,10,0">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="REQUESTS" />
            <TextBlock Classes="readout" Text="{Binding TotalRequests}" />
            <TextBlock Classes="mono muted"
                       Text="{Binding FailedRequests, StringFormat='{}{0} failed'}" Margin="0,7,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="tile">
          <StackPanel Spacing="3">
            <TextBlock Classes="eyebrow" Text="TOKENS" />
            <TextBlock Classes="readout" Text="{Binding CompletionTokens}" />
            <TextBlock Classes="mono muted"
                       Text="{Binding PromptTokens, StringFormat='{}{0} prompt'}" Margin="0,7,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Hardware -->
      <Border Classes="panel">
        <StackPanel Spacing="14">
          <TextBlock Classes="heading" Text="Hardware" />

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <TextBlock Grid.Column="0" Classes="mono muted" Text="CPU" VerticalAlignment="Center" MinWidth="60" />
            <ProgressBar Grid.Column="1" Value="{Binding CpuPercent}" Maximum="100" Height="5"
                         Foreground="{DynamicResource Data}"
                         Background="{DynamicResource SurfaceSunken}" />
            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding CpuUsage}"
                       MinWidth="52" TextAlignment="Right" />
          </Grid>

          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <TextBlock Grid.Column="0" Classes="mono muted" Text="Memory" VerticalAlignment="Center" MinWidth="60" />
            <ctl:Sparkline Grid.Column="1" Height="20" Values="{Binding CpuTrace}"
                           Stroke="{DynamicResource DataDim}" StrokeThickness="1.2" />
            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding ProcessMemory}"
                       MinWidth="52" TextAlignment="Right" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Gpus}" IsVisible="{Binding HasGpu}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GpuRow">
                <StackPanel Spacing="7" Margin="0,10,0,0">
                  <Border Classes="rule" Margin="0,0,0,4" />

                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Name}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="mono muted" Text="{Binding Temperature}" />
                      <TextBlock Classes="mono muted" Text="{Binding Power}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <TextBlock Grid.Column="0" Classes="mono muted" Text="Load"
                               VerticalAlignment="Center" MinWidth="60" />
                    <ProgressBar Grid.Column="1" Value="{Binding UtilizationPercent}" Maximum="100" Height="5"
                                 Foreground="{DynamicResource Signal}"
                                 Background="{DynamicResource SurfaceSunken}" />
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Utilization}"
                               MinWidth="52" TextAlignment="Right" />
                  </Grid>

                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <TextBlock Grid.Column="0" Classes="mono muted" Text="VRAM"
                               VerticalAlignment="Center" MinWidth="60" />
                    <ProgressBar Grid.Column="1" Value="{Binding MemoryPercent}" Maximum="100" Height="5"
                                 Foreground="{DynamicResource Data}"
                                 Background="{DynamicResource SurfaceSunken}" />
                    <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Memory}"
                               MinWidth="132" TextAlignment="Right" />
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="mono muted" IsVisible="{Binding !HasGpu}"
                     Text="No NVIDIA GPU reported. GPU counters come from nvidia-smi; other vendors are not sampled." />
        </StackPanel>
      </Border>

      <!-- Per-model usage -->
      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="heading" Text="Requests by model" />

          <ItemsControl ItemsSource="{Binding ModelUsage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ModelUsageRow">
                <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="14" Margin="0,3">
                  <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Model}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="1" Value="{Binding Share}" Maximum="100" Height="5"
                               Foreground="{DynamicResource DataDim}"
                               Background="{DynamicResource SurfaceSunken}" />
                  <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Requests}"
                             MinWidth="44" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="mono muted" IsVisible="{Binding !ModelUsage.Count}"
                     Text="Nothing recorded yet. Send a message from the Playground and this fills in." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
