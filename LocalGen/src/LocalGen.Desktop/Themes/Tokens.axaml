<!--
  LocalGen design tokens.

  Direction: an instrument panel, not a chat app. Local inference is the one kind of AI where the
  machine is visible — VRAM, offloaded layers, tokens per second — so the surface is graphite with
  a single illuminated amber signal, the way lit equipment reads, and teal reserved for measured
  data. Both themes are first-class; the light theme is a warm paper grey rather than white so the
  amber keeps its contrast.

  Type rule: anything the machine measures is set in mono; anything a person writes is set in Inter.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces: cool graphite, never pure black — black flattens the depth between panels. -->
      <Color x:Key="SurfaceSunkenColor">#0D1014</Color>
      <Color x:Key="SurfaceBaseColor">#12151A</Color>
      <Color x:Key="SurfaceRaisedColor">#1A1F26</Color>
      <Color x:Key="SurfaceOverlayColor">#232932</Color>

      <Color x:Key="EdgeColor">#262C35</Color>
      <Color x:Key="EdgeStrongColor">#39424E</Color>

      <Color x:Key="TextPrimaryColor">#E8EAED</Color>
      <Color x:Key="TextSecondaryColor">#AEB6C2</Color>
      <Color x:Key="TextMutedColor">#7A8391</Color>

      <!-- Signal amber: the powered-on colour. Used for primary action and the running state. -->
      <Color x:Key="SignalColor">#F5A524</Color>
      <Color x:Key="SignalDimColor">#8A5D14</Color>
      <Color x:Key="SignalWashColor">#26200F</Color>

      <!-- Teal is measurement: throughput, memory, anything plotted. -->
      <Color x:Key="DataColor">#2DD4BF</Color>
      <Color x:Key="DataDimColor">#177A6E</Color>

      <Color x:Key="AlertColor">#F2545B</Color>
      <Color x:Key="AlertWashColor">#2A1417</Color>
      <Color x:Key="SuccessColor">#4ADE80</Color>

      <!--
        Fluent derives every accented control — checkboxes, sliders, toggles, selection — from
        these. Left at their defaults they paint Windows blue, which would put a colour in the
        interface that belongs to no part of the palette.
      -->
      <Color x:Key="SystemAccentColor">#F5A524</Color>
      <Color x:Key="SystemAccentColorLight1">#F7B54A</Color>
      <Color x:Key="SystemAccentColorLight2">#F9C673</Color>
      <Color x:Key="SystemAccentColorLight3">#FBD79C</Color>
      <Color x:Key="SystemAccentColorDark1">#D18B14</Color>
      <Color x:Key="SystemAccentColorDark2">#A76F10</Color>
      <Color x:Key="SystemAccentColorDark3">#7D530C</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="SurfaceSunkenColor">#DFE2E7</Color>
      <Color x:Key="SurfaceBaseColor">#EDEEF0</Color>
      <Color x:Key="SurfaceRaisedColor">#FFFFFF</Color>
      <Color x:Key="SurfaceOverlayColor">#F6F7F9</Color>

      <Color x:Key="EdgeColor">#D2D6DD</Color>
      <Color x:Key="EdgeStrongColor">#B4BAC5</Color>

      <Color x:Key="TextPrimaryColor">#14171C</Color>
      <Color x:Key="TextSecondaryColor">#3D4552</Color>
      <Color x:Key="TextMutedColor">#5A626F</Color>

      <!-- Amber darkens to ochre in light mode so it still passes contrast on paper grey. -->
      <Color x:Key="SignalColor">#B26B00</Color>
      <Color x:Key="SignalDimColor">#E8B978</Color>
      <Color x:Key="SignalWashColor">#FBF0DC</Color>

      <Color x:Key="DataColor">#0D8C7D</Color>
      <Color x:Key="DataDimColor">#7FCFC5</Color>

      <Color x:Key="AlertColor">#C0333A</Color>
      <Color x:Key="AlertWashColor">#FBE9EA</Color>
      <Color x:Key="SuccessColor">#1F9D50</Color>

      <Color x:Key="SystemAccentColor">#B26B00</Color>
      <Color x:Key="SystemAccentColorLight1">#C97C0A</Color>
      <Color x:Key="SystemAccentColorLight2">#E09417</Color>
      <Color x:Key="SystemAccentColorLight3">#F0AC3D</Color>
      <Color x:Key="SystemAccentColorDark1">#935800</Color>
      <Color x:Key="SystemAccentColorDark2">#744600</Color>
      <Color x:Key="SystemAccentColorDark3">#553300</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes resolve against whichever theme dictionary is active. -->
  <SolidColorBrush x:Key="SurfaceSunken" Color="{DynamicResource SurfaceSunkenColor}" />
  <SolidColorBrush x:Key="SurfaceBase" Color="{DynamicResource SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfaceRaised" Color="{DynamicResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceOverlay" Color="{DynamicResource SurfaceOverlayColor}" />

  <SolidColorBrush x:Key="Edge" Color="{DynamicResource EdgeColor}" />
  <SolidColorBrush x:Key="EdgeStrong" Color="{DynamicResource EdgeStrongColor}" />

  <SolidColorBrush x:Key="TextPrimary" Color="{DynamicResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{DynamicResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}" />

  <SolidColorBrush x:Key="Signal" Color="{DynamicResource SignalColor}" />
  <SolidColorBrush x:Key="SignalDim" Color="{DynamicResource SignalDimColor}" />
  <SolidColorBrush x:Key="SignalWash" Color="{DynamicResource SignalWashColor}" />

  <SolidColorBrush x:Key="Data" Color="{DynamicResource DataColor}" />
  <SolidColorBrush x:Key="DataDim" Color="{DynamicResource DataDimColor}" />

  <SolidColorBrush x:Key="Alert" Color="{DynamicResource AlertColor}" />
  <SolidColorBrush x:Key="AlertWash" Color="{DynamicResource AlertWashColor}" />
  <SolidColorBrush x:Key="Success" Color="{DynamicResource SuccessColor}" />

  <!--
    Two families, one rule. Inter carries human language; the mono stack carries every measured
    value, so a number never looks like prose and columns of figures line up.
  -->
  <FontFamily x:Key="FontBody">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono,Consolas,JetBrains Mono,SF Mono,Menlo,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Type scale: a fourth-ish ratio, tightened at display sizes. -->
  <x:Double x:Key="TextDisplay">30</x:Double>
  <x:Double x:Key="TextTitle">20</x:Double>
  <x:Double x:Key="TextHeading">15</x:Double>
  <x:Double x:Key="TextBody">13.5</x:Double>
  <x:Double x:Key="TextSmall">12</x:Double>
  <x:Double x:Key="TextMicro">10.5</x:Double>

  <!-- Geometry: shallow radii keep panels reading as equipment rather than as cards. -->
  <CornerRadius x:Key="RadiusSmall">3</CornerRadius>
  <CornerRadius x:Key="RadiusMedium">5</CornerRadius>
  <CornerRadius x:Key="RadiusLarge">8</CornerRadius>

  <Thickness x:Key="PadTight">8,6</Thickness>
  <Thickness x:Key="PadDefault">14,10</Thickness>
  <Thickness x:Key="PadPanel">20</Thickness>

</ResourceDictionary>
