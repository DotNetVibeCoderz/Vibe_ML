<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Description>LocalGen Admin Control — cross-platform desktop console for the inference engine.</Description>
    <AssemblyName>LocalGen.Desktop</AssemblyName>
    <RootNamespace>LocalGen.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Parsing markdown is a solved problem; rendering it into Avalonia controls is not. -->
    <PackageReference Include="Markdig" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalGen.Core\LocalGen.Core.csproj" />
    <ProjectReference Include="..\LocalGen.Runtime\LocalGen.Runtime.csproj" />
    <ProjectReference Include="..\LocalGen.Server\LocalGen.Server.csproj" />
    <ProjectReference Include="..\LocalGen.Kernel\LocalGen.Kernel.csproj" />
    <ProjectReference Include="..\LocalGen.Rag\LocalGen.Rag.csproj" />
    <ProjectReference Include="..\LocalGen.Sdk\LocalGen.Sdk.csproj" />
  </ItemGroup>

</Project>
