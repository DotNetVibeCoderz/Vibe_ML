{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LocalGen": {
    "Server": {
      "Host": "127.0.0.1",
      "Port": 11434,
      "ApiKey": null,
      "CorsOrigins": [ "*" ],
      "ModelIdleTimeout": "00:05:00",
      "MaxLoadedModels": 2,
      "MaxConcurrentRequests": 4
    },
    "Engine": {
      "Default": "LlamaSharp",
      "Device": "Auto",
      "GpuLayers": null,
      "ContextSize": null,
      "Threads": null,
      "TensorSplit": []
    },
    "Runtime": {
      "OfflineMode": false,
      "PreloadModel": null,
      "CollectMetrics": true,
      "MetricsInterval": "00:00:02"
    },
    "Tools": {
      "Math": true,
      "InternetSearch": true,
      "Download": true,
      "WebScrape": true,
      "CodeExecution": true,
      "TimeAndDate": true,
      "FileSystem": true,
      "TavilyApiKey": null,
      "AllowedPaths": [],
      "CodeExecutionTimeout": "00:02:00",
      "AllowDependencyInstall": false
    },
    "Rag": {
      "Provider": "sqlite",
      "ConnectionString": "",
      "EmbeddingModel": "nomic-embed-text",
      "ChunkSize": 1000,
      "ChunkOverlap": 200,
      "TopK": 5,
      "MinRelevance": 0.5
    }
  }
}
