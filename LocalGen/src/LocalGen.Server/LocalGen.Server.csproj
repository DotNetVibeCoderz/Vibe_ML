<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>
      LocalGen inference server: an OpenAI-compatible HTTP API over local models.
      Built as an executable that is also referenceable as a library, so the Avalonia
      Admin Control can start and stop the service in-process.
    </Description>
    <AssemblyName>localgen-server</AssemblyName>
    <RootNamespace>LocalGen.Server</RootNamespace>
    <UserSecretsId>localgen-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalGen.Core\LocalGen.Core.csproj" />
    <ProjectReference Include="..\LocalGen.Runtime\LocalGen.Runtime.csproj" />
    <ProjectReference Include="..\LocalGen.Engines.LlamaSharp\LocalGen.Engines.LlamaSharp.csproj" />
    <ProjectReference Include="..\LocalGen.Engines.Onnx\LocalGen.Engines.Onnx.csproj" />
  </ItemGroup>

</Project>
