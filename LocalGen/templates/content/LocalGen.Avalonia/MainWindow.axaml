<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:LocalGenDesktop"
        mc:Ignorable="d"
        x:Class="LocalGenDesktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="LocalGen Desktop"
        Width="900" Height="680"
        MinWidth="520" MinHeight="400">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Padding="14,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"
                  HorizontalAlignment="Stretch" MaxWidth="360" />
        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"
                   Opacity="0.7" />
        <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="14">
      <ItemsControl ItemsSource="{Binding Turns}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:ChatTurn">
            <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="6"
                    MaxWidth="640"
                    HorizontalAlignment="{Binding IsUser, Converter={x:Static local:TurnConverters.Alignment}}"
                    Background="{DynamicResource SystemControlBackgroundListLowBrush}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="11"
                           Opacity="0.6" />
                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="14" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBox Grid.Column="0" Text="{Binding Prompt}"
                 Watermark="Ask something"
                 AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" />

        <Button Grid.Column="1" Content="Send" MinWidth="84"
                Command="{Binding SendCommand}"
                IsVisible="{Binding !IsGenerating}" />
        <Button Grid.Column="1" Content="Stop" MinWidth="84"
                Command="{Binding StopCommand}"
                IsVisible="{Binding IsGenerating}" />
      </Grid>
    </Border>
  </Grid>
</Window>
