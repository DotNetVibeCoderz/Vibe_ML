<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>LocalGen.Templates</PackageId>
    <Title>LocalGen project templates</Title>
    <Description>
      Project templates for applications built on LocalGen: a console client, an ASP.NET Core API
      that uses a local model, and an Avalonia desktop chat client.
    </Description>
    <PackageTags>dotnet-new;templates;ai;llm;localgen</PackageTags>

    <!--
      A template pack ships content, not an assembly. The build output is excluded and the
      template files are packed verbatim under content/.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

    <!-- NU5128: expected for a package with no lib folder. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*"
             Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
