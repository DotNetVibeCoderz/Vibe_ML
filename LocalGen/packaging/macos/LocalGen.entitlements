<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime is required for notarisation, and it blocks by default the two things a
  .NET application needs to run at all. Both exceptions below are about the runtime's own JIT,
  not about anything LocalGen does with them.

  Deliberately absent: com.apple.security.cs.disable-library-validation. Every library LocalGen
  loads is signed by the same build, so nothing needs that exception — and it is the one that
  would let an unsigned dylib into the process.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
