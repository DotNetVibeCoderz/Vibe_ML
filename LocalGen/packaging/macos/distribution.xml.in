<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>LocalGen</title>
    <organization>studio.gravicode</organization>

    <welcome file="welcome.html" mime-type="text/html" />
    <license file="license.html" mime-type="text/html" />
    <conclusion file="conclusion.html" mime-type="text/html" />

    <!-- Apple Silicon and Intel are separate packages; each declares the architecture it holds. -->
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64" />

    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0" />
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="@BUNDLE_ID@" />
        </line>
    </choices-outline>

    <choice id="default" />
    <choice id="@BUNDLE_ID@" visible="false">
        <pkg-ref id="@BUNDLE_ID@" />
    </choice>

    <pkg-ref id="@BUNDLE_ID@" version="@VERSION@" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
