<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gravicode.Science.Tests.DaskNet.Lakehouse</RootNamespace>
    <AssemblyName>DaskNet.Lakehouse.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\..\src\DaskNet.Lakehouse\DaskNet.Lakehouse.csproj" />
  </ItemGroup>

  <!-- Tables written by delta-rs and pyiceberg (tools/verify/make_lake_fixtures.py). -->
  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
