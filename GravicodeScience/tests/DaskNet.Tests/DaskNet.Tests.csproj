<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Gravicode.Science.Tests.DaskNet</RootNamespace>
    <AssemblyName>DaskNet.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <!-- Computations take the cancellation token they are about; the test token is not it. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="..\..\src\DaskNet\DaskNet.csproj" />
    <!-- The process-cluster tests start this host as child processes. -->
    <ProjectReference Include="..\..\tools\DaskNet.Worker\DaskNet.Worker.csproj" />
  </ItemGroup>

</Project>
