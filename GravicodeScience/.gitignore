# Secrets. testkey.txt holds a live Azure OpenAI key and a Tavily key; ScienceAppGen reads them
# from SCIENCEAPPGEN_APIKEY / SCIENCEAPPGEN_ENDPOINT / TAVILY_API_KEY, and app.config ships with
# both key fields blank, so nothing here needs the file to be committed.
testkey.txt
*.key
appsettings.*.local.json
