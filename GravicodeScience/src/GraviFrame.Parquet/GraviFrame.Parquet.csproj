<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Gravicode.Science.GraviFrame</RootNamespace>
    <AssemblyName>Gravicode.Science.GraviFrame.Parquet</AssemblyName>
    <PackageId>Gravicode.Science.GraviFrame.Parquet</PackageId>
    <!-- Kept out of GraviFrame: Parquet.Net's managed Parquet.dll shares its file name with the native parquet.dll that GDAL imports,
         and Windows binds GDAL to whichever module named parquet.dll is loaded first. Libraries that only need data frames
         (GraviLearn, GraviText, HF.Net) should not drag it in. -->
    <Description>Apache Parquet read/write for GraviFrame data frames (Parquet.Net). Part of Gravicode.Science.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" />
    <ProjectReference Include="..\GraviFrame\GraviFrame.csproj" />
  </ItemGroup>

</Project>
