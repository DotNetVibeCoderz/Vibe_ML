<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScienceAppGen.ViewModels"
             xmlns:views="using:ScienceAppGen.Views"
             xmlns:edit="using:AvaloniaEdit"
             x:Class="ScienceAppGen.Views.ConverterView"
             x:DataType="vm:ConverterViewModel">

  <!--
    Python to C#. Left: what was found and where each module is in the pipeline. Centre: the
    Python and the C# side by side. Right: where it goes, the Convert button, and the activity.
    Nothing reaches the model until Convert is pressed; choosing a source only scans and plans.
  -->
  <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppGround}">

    <!-- ============================================ header -->
    <Border Grid.Row="0" Background="{DynamicResource PanelGround}" Padding="18,12"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="3" Height="20" CornerRadius="2" Background="{DynamicResource SpectrumRule}" />
          <TextBlock Text="Python" FontSize="{DynamicResource FontLarge}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextHighBrush}" VerticalAlignment="Center" />
          <TextBlock Text="→" FontSize="{DynamicResource FontLarge}" Foreground="{DynamicResource TextFaintBrush}"
                     VerticalAlignment="Center" />
          <TextBlock Text="C#" FontSize="{DynamicResource FontLarge}" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrightBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="caption" Margin="14,0,0,0" VerticalAlignment="Center"
                     Text="A script, a notebook or a whole project, onto Gravicode.Science and Visual.Net." />
        </StackPanel>
        <Button Grid.Column="2" Classes="ghost" Content="Back to editor" Click="OnBack"
                ToolTip.Tip="Return to the workspace (Esc)" />
      </Grid>
    </Border>

    <!-- ============================================ package strip: the signature -->
    <Border Grid.Row="1" Background="{DynamicResource PanelGround}" Padding="18,8"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1"
            IsVisible="{Binding HasSource}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Packages}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PackageChip">
              <StackPanel Orientation="Horizontal" Spacing="7" ToolTip.Tip="{Binding Note}">
                <TextBlock Classes="mono" Text="{Binding Package}" Foreground="{DynamicResource TextBaseBrush}"
                           VerticalAlignment="Center" />
                <Border Width="26" Height="2" CornerRadius="1" VerticalAlignment="Center"
                        Background="{Binding Colour, Converter={x:Static views:HexBrushConverter.Instance}}" />
                <TextBlock Text="{Binding Target}" FontWeight="SemiBold" FontSize="{DynamicResource FontSmall}"
                           VerticalAlignment="Center"
                           Foreground="{Binding Colour, Converter={x:Static views:HexBrushConverter.Instance}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="300,*,340">

      <!-- ============================================ source -->
      <Border Grid.Column="0" Background="{DynamicResource PanelGround}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,12">

          <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="SOURCE" Classes="panelHeader" />
            <Grid ColumnDefinitions="*,8,*">
              <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="File…" Click="OnChooseFile" IsEnabled="{Binding IsIdle}"
                      ToolTip.Tip="A .py script or an .ipynb notebook" />
              <Button Grid.Column="2" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Folder…" Click="OnChooseFolder" IsEnabled="{Binding IsIdle}"
                      ToolTip.Tip="A project: every .py and .ipynb in it, plus its data files" />
            </Grid>
            <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold" FontSize="{DynamicResource FontMedium}"
                       Foreground="{DynamicResource TextHighBrush}" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasSource}" Margin="0,4,0,0" />
            <TextBlock Classes="mono" Text="{Binding SourcePath}" FontSize="10.5" TextTrimming="PrefixCharacterEllipsis"
                       Foreground="{DynamicResource TextFaintBrush}" IsVisible="{Binding HasSource}"
                       ToolTip.Tip="{Binding SourcePath}" />
            <TextBlock Classes="caption" Text="{Binding SourceSummary}" IsVisible="{Binding HasSource}" />
          </StackPanel>

          <TextBlock Grid.Row="1" Text="MODULES" Classes="panelHeader" Margin="0,18,0,8"
                     IsVisible="{Binding HasSource}" />

          <!-- The pipeline: one row per module, in conversion order, each with its live status. -->
          <ListBox Grid.Row="2" Classes="cards" ItemsSource="{Binding Modules}"
                   SelectedItem="{Binding SelectedModule}" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConvertedModuleItem">
                <Border Name="Card" Padding="10,8" CornerRadius="{DynamicResource RadiusSmall}" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <Border Grid.Column="0" Grid.RowSpan="2" Width="8" Height="8" CornerRadius="4"
                            Margin="0,5,10,0" VerticalAlignment="Top"
                            Background="{Binding StatusColour, Converter={x:Static views:HexBrushConverter.Instance}}" />
                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                      <TextBlock Classes="mono" Text="{Binding PythonPath}" FontSize="12"
                                 Foreground="{DynamicResource TextHighBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="10.5" Margin="8,0,0,0"
                                 Foreground="{Binding StatusColour, Converter={x:Static views:HexBrushConverter.Instance}}" />
                    </Grid>
                    <TextBlock Grid.Column="1" Grid.Row="1" Classes="caption" FontSize="11" Margin="0,2,0,0"
                               Text="{Binding Target}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3" Classes="caption" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="{Binding SkippedSummary}" IsVisible="{Binding SkippedSummary.Length}" />

          <!-- Empty state. -->
          <StackPanel Grid.Row="2" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding !HasSource}">
            <TextBlock Classes="body" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Choose a .py file, a notebook, or a folder." />
            <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                       Text="numpy, pandas, scikit-learn and scipy become GraviNum, GraviFrame, GraviLearn and SciNet; matplotlib, seaborn and plotly become Visual.Net." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ============================================ side by side -->
      <Grid Grid.Column="1" ColumnDefinitions="*,1,*" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelGround}" Padding="12,7"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="PYTHON" Classes="panelHeader" />
            <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding SelectedModule.PythonPath, FallbackValue=''}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource PanelGround}" Padding="12,7"
                BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="C#" Classes="panelHeader" Foreground="{DynamicResource AccentBrightBrush}" />
            <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                       Text="{Binding SelectedModule.CSharpPath, FallbackValue=''}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>

        <edit:TextEditor Name="PythonEditor" Grid.Row="1" Grid.Column="0" IsReadOnly="True"
                         Background="{DynamicResource EditorGround}" Foreground="{DynamicResource TextHighBrush}"
                         LineNumbersForeground="{DynamicResource EditorGutter}" ShowLineNumbers="True"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource BorderSoft}" />
        <edit:TextEditor Name="CSharpEditor" Grid.Row="1" Grid.Column="2" IsReadOnly="True"
                         Background="{DynamicResource EditorGround}" Foreground="{DynamicResource TextHighBrush}"
                         LineNumbersForeground="{DynamicResource EditorGutter}" ShowLineNumbers="True"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

        <!-- Before conversion the C# side says what will happen rather than sitting blank. -->
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Margin="24" IsVisible="{Binding SelectedModule.CSharp, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=False}">
          <TextBlock Classes="body" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}"
                     Text="{Binding SelectedModule.Target, FallbackValue=''}" />
          <TextBlock Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Text="The converted file appears here as soon as the model returns it." />
        </StackPanel>
      </Grid>

      <!-- ============================================ output, convert, activity -->
      <Border Grid.Column="2" Background="{DynamicResource PanelGround}"
              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,12">

          <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="OUTPUT" Classes="panelHeader" />
            <TextBlock Classes="caption" Text="Project name" />
            <TextBox Classes="field" Text="{Binding ProjectName}" IsEnabled="{Binding IsIdle}" />
            <TextBlock Classes="caption" Text="Folder (empty, or a previous conversion)" />
            <Grid ColumnDefinitions="*,6,Auto">
              <TextBox Grid.Column="0" Classes="field" Text="{Binding OutputDirectory}" IsEnabled="{Binding IsIdle}"
                       FontFamily="{DynamicResource MonoFont}" FontSize="11" />
              <Button Grid.Column="2" Classes="ghost" Content="…" Click="OnChooseOutput" IsEnabled="{Binding IsIdle}"
                      ToolTip.Tip="Choose the output folder" />
            </Grid>
            <CheckBox Classes="field" Content="Build, and repair compiler errors" IsChecked="{Binding BuildAndRepair}"
                      IsEnabled="{Binding IsIdle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="26,0,0,0" IsEnabled="{Binding BuildAndRepair}">
              <TextBlock Classes="caption" Text="Repair rounds" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding RepairRounds}" Minimum="0" Maximum="8" Increment="1" Width="110"
                             FormatString="0" IsEnabled="{Binding IsIdle}" />
            </StackPanel>
            <CheckBox Classes="field" Content="Run the program once it builds" IsChecked="{Binding RunAfterBuild}"
                      IsEnabled="{Binding BuildAndRepair}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,12">
            <Grid ColumnDefinitions="*,8,Auto">
              <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Convert" Click="OnConvert" IsEnabled="{Binding CanConvert}"
                      IsVisible="{Binding IsIdle}" />
              <Button Grid.Column="0" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Cancel" Click="OnCancel" IsVisible="{Binding IsRunning}" />
              <ProgressBar Grid.Column="2" Width="44" IsIndeterminate="True" IsVisible="{Binding IsRunning}"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="caption" FontSize="11" Text="{Binding ModelLabel, StringFormat='Model: {0}'}" />
            <TextBlock Classes="body" FontSize="{DynamicResource FontSmall}" TextWrapping="Wrap"
                       Text="{Binding StatusText}" />
          </StackPanel>

          <!-- Activity: what happened, in order, including the converted program's own output. -->
          <Border Grid.Row="2" Background="{DynamicResource EditorGround}" CornerRadius="{DynamicResource RadiusSmall}"
                  BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
            <Panel>
            <TextBlock Classes="caption" FontSize="11" Margin="12" TextWrapping="Wrap"
                       IsVisible="{Binding !Activity.Count}"
                       Text="Each step shows up here: every file as the model returns it, the build, each repair round, and what the converted program prints." />
            <ScrollViewer Name="ActivityScroll" Padding="10,8">
              <ItemsControl ItemsSource="{Binding Activity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityLine">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                      <Border Grid.Column="0" Width="5" Height="5" CornerRadius="3" Margin="0,6,8,0"
                              VerticalAlignment="Top" IsVisible="{Binding !IsProgramOutput}"
                              Background="{Binding Colour, Converter={x:Static views:HexBrushConverter.Instance}}" />
                      <SelectableTextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                           FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                           Foreground="{DynamicResource TextBaseBrush}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </Panel>
          </Border>

          <StackPanel Grid.Row="3" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasResult}">
            <TextBlock Classes="body" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold"
                       Text="{Binding ResultSummary}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Todos}" MaxHeight="96">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Classes="caption" FontSize="11" TextWrapping="Wrap" Text="{Binding StringFormat='· {0}'}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,8,*">
              <Button Grid.Column="0" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Open in workspace" Click="OnOpenResult" />
              <Button Grid.Column="2" Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Show folder" Click="OnShowFolder" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
