<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Every ScienceAppGen setting lives here and is editable from Tools > Settings.
    The UI writes changes back to this file, so hand edits and UI edits are equivalent.

    API keys are deliberately blank in source control. Put yours in via the Settings
    dialog, or set the matching environment variable, which always wins over this file:

      SCIENCEAPPGEN_APIKEY      overrides llm.apiKey
      SCIENCEAPPGEN_ENDPOINT    overrides llm.endpoint
      TAVILY_API_KEY            overrides tools.tavilyApiKey
  -->

  <appSettings>

    <!-- ===== LLM provider =====================================================
         provider : OpenAI | AzureOpenAI | Anthropic | Google | Ollama
         endpoint : required for AzureOpenAI and Ollama, optional elsewhere
                    (leave blank to use each provider's default host)
    -->
    <add key="llm.provider" value="AzureOpenAI" />
    <add key="llm.model" value="gpt-5-mini" />
    <add key="llm.apiKey" value="" />
    <add key="llm.endpoint" value="" />
    <add key="llm.temperature" value="0.3" />
    <add key="llm.maxTokens" value="8192" />
    <add key="llm.timeoutSeconds" value="180" />

    <!-- Comma-separated list offered in the chat panel's model picker. -->
    <add key="llm.availableModels" value="gpt-5-mini,gpt-5.6-luna,gpt-4o,gpt-4o-mini,claude-sonnet-4-20250514,gemini-2.0-flash,llama3.2" />

    <add key="llm.systemPrompt" value="You are Jack, the Code Bender - the coding assistant built into ScienceAppGen.

You build complete, working .NET applications for data scientists on top of the Gravicode.Science
libraries: GraviNum (arrays and linear algebra), GraviFrame (dataframes), GraviLearn (machine
learning), GraviText (NLP), GraviGraph (graph ML) and GraviProb (Bayesian inference).

How you work:
- Use your tools. To create or change an application, call the project and file functions rather
  than printing code into the chat and asking the user to copy it.
- Write the whole application: project file, entry point, and every source file it needs. A
  half-written project is worse than none.
- After writing files, call BuildProject and fix whatever it reports. Do not claim something works
  until the build has actually succeeded.
- Look things up rather than guessing. GravicodeReference tells you the real API surface;
  SearchInternet and ScrapeWebPage cover anything outside it.
- Target .NET 10 and C# 13. Prefer clear code over clever code.

How you talk:
- Say what you did and what you found, briefly. No preamble, no filler.
- Report failures plainly, with the error text.
- When a request is ambiguous in a way that changes the result, ask one specific question. Otherwise
  pick the sensible default, say which, and continue." />

    <!-- ===== Tools ============================================================ -->
    <add key="tools.tavilyApiKey" value="" />
    <add key="tools.tavilyMaxResults" value="5" />
    <add key="tools.webTimeoutSeconds" value="30" />
    <add key="tools.autoApproveFileWrites" value="true" />

    <!-- ===== Editor =========================================================== -->
    <add key="editor.showLineNumbers" value="true" />
    <add key="editor.fontFamily" value="Cascadia Mono,Consolas,Menlo,monospace" />
    <add key="editor.fontSize" value="13" />
    <add key="editor.tabSize" value="4" />
    <add key="editor.wordWrap" value="false" />
    <add key="editor.highlightCurrentLine" value="true" />

    <!-- ===== Workspace ======================================================== -->
    <add key="workspace.lastProject" value="" />
    <add key="workspace.projectsRoot" value="" />
    <add key="workspace.chatPanelWidth" value="420" />
    <add key="workspace.chatPanelVisible" value="true" />
    <add key="workspace.explorerWidth" value="260" />
    <add key="workspace.logsHeight" value="180" />
    <add key="workspace.theme" value="Dark" />

  </appSettings>

</configuration>
