<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ScienceAppGen</RootNamespace>
    <AssemblyName>ScienceAppGen</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0070;CS0618</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The converter's deterministic parts are tested from tests/ScienceAppGen.Tests. -->
    <InternalsVisibleTo Include="ScienceAppGen.Tests" />
    <!-- Sample Python projects for the converter: documentation and test input, not app content. -->
    <None Remove="Samples\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
    <EmbeddedResource Include="Templates\**" />
    <None Update="app.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- Semantic Kernel. The Google and Ollama connectors ship as alpha only; Anthropic has
         no official connector at all, so Claude is served by a hand-written
         IChatCompletionService in Services/AnthropicChatCompletionService.cs. -->
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureOpenAI" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Google" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Ollama" />

    <PackageReference Include="System.Configuration.ConfigurationManager" />

    <!-- Visual.Net, so the Python converter can describe its real API by reflection. -->
    <PackageReference Include="Gravicode.Matplotlib.Net" />
    <PackageReference Include="Gravicode.Seaborn.Net" />
    <PackageReference Include="Gravicode.Plotly.Net" />
    <!-- Avalonia brings SkiaSharp 3's Linux native library, which wins over Visual.Net's
         SkiaSharp 4 and breaks it on Linux; see the Science Gallery notes in CLAUDE.md. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" VersionOverride="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated projects reference these, and the assistant answers questions about them. -->
    <ProjectReference Include="..\..\src\GraviNum\GraviNum.csproj" />
    <ProjectReference Include="..\..\src\GraviFrame\GraviFrame.csproj" />
    <ProjectReference Include="..\..\src\GraviLearn\GraviLearn.csproj" />
    <!-- The converter reflects over SciNet to give the model scipy's real counterparts. -->
    <ProjectReference Include="..\..\src\SciNet\SciNet.csproj" />
  </ItemGroup>

</Project>
