<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================ type -->

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBaseBrush}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
    <Setter Property="LineHeight" Value="38" />
    <Setter Property="FontSize" Value="34" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="LineHeight" Value="23" />
  </Style>

  <!-- An eyebrow always names something true: the domain of a use case, a section. -->
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
  </Style>

  <!-- ============================================================ cards -->

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <Style Selector="Button.showcaseCard">
    <Setter Property="Background" Value="{DynamicResource CardGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.showcaseCard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource CardGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}" />
  </Style>
  <Style Selector="Button.showcaseCard:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WellGround}" />
  </Style>
  <Style Selector="Button.showcaseCard:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ============================================================ buttons -->

  <Style Selector="Button.ink">
    <Setter Property="Background" Value="{DynamicResource InkButton}" />
    <Setter Property="Foreground" Value="{DynamicResource InkButtonText}" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.ink:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkButtonHover}" />
    <Setter Property="Foreground" Value="{DynamicResource InkButtonText}" />
  </Style>
  <Style Selector="Button.ink:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource WellGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextHighBrush}" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ============================================================ sidebar -->

  <Style Selector="Border.sidebar TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
  </Style>
  <Style Selector="Border.sidebar TextBlock.sideMuted">
    <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}" />
  </Style>
  <Style Selector="Border.sidebar TextBlock.sideHeading">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource SidebarMuted}" />
  </Style>

  <Style Selector="ListBox.sideList">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.sideList ListBoxItem">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
  </Style>
  <Style Selector="ListBox.sideList ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarHover}" />
  </Style>
  <Style Selector="ListBox.sideList ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
  </Style>
  <Style Selector="ListBox.sideList ListBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
  </Style>

  <Style Selector="ToggleButton.libToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ToggleButton.libToggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarHover}" />
  </Style>
  <Style Selector="ToggleButton.libToggle:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
  </Style>
  <Style Selector="ToggleButton.libToggle:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SidebarSelected}" />
  </Style>

  <!-- ============================================================ inputs -->

  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="{DynamicResource CardGround}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
  </Style>

</Styles>
