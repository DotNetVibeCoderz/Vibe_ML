<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Gravicode Science Gallery - real-world use cases of the seven Gravicode.Science libraries,
    each one runnable, with its chart (drawn by Visual.Net's Matplotlib.Net) and its exact source.
    Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ScienceGallery</RootNamespace>
    <AssemblyName>ScienceGallery</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Visual.Net wrapper projects live under this folder; their obj/ holds generated .cs
         files that must not be compiled into the gallery as well. -->
    <Compile Remove="VisualNet\**" />
    <None Remove="VisualNet\**" />
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
    <!-- The code panel shows each showcase's own source file, so what you read is what ran. -->
    <EmbeddedResource Include="Showcases\**\*.cs" LogicalName="Showcase:%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GraviNum\GraviNum.csproj" />
    <ProjectReference Include="..\..\src\GraviFrame\GraviFrame.csproj" />
    <ProjectReference Include="..\..\src\GraviLearn\GraviLearn.csproj" />
    <ProjectReference Include="..\..\src\GraviText\GraviText.csproj" />
    <ProjectReference Include="..\..\src\GraviGraph\GraviGraph.csproj" />
    <ProjectReference Include="..\..\src\GraviProb\GraviProb.csproj" />
    <ProjectReference Include="..\..\src\SciNet\SciNet.csproj" />
    <!-- Charts. See VisualNet\VisualNet.props for where the Visual.Net sources come from. -->
    <ProjectReference Include="VisualNet\Matplotlib.Net\Matplotlib.Net.csproj" />
    <ProjectReference Include="VisualNet\Seaborn.Net\Seaborn.Net.csproj" />
  </ItemGroup>

</Project>
