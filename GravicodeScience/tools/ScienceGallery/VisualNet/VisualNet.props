<Project>

  <!--
    Visual.Net (Matplotlib.Net, Seaborn.Net, Visual.Net.Core) is compiled from its own repository,
    DotNetVibeCoderz/Vibe_Charting, rather than copied here. Visual.Net carries an older snapshot of
    GraviNum/GraviFrame/GraviLearn under the same assembly names, so these wrapper projects compile
    only its chart libraries and link them to this repository's Gravicode.Science projects instead.

    Where the sources are looked for, in order:
      1. the VISUALNET_ROOT environment variable (CI checks Vibe_Charting out and sets it);
      2. a Vibe_Charting checkout next to the Vibe_ML checkout (the usual local layout).
  -->
  <PropertyGroup>
    <VisualNetRoot Condition="'$(VisualNetRoot)' == '' And '$(VISUALNET_ROOT)' != ''">$(VISUALNET_ROOT)</VisualNetRoot>
    <VisualNetRoot Condition="'$(VisualNetRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..\..\Vibe_Charting\Visual.Net'))</VisualNetRoot>
    <VisualNetSrc>$(VisualNetRoot)\src</VisualNetSrc>

    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416;CS8602;CS8604</NoWarn>
    <!-- SkiaSharp 4 is what Visual.Net renders with; pinning it centrally would also move the
         ScottPlot samples (built against SkiaSharp 3) through transitive pinning. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <Target Name="CheckVisualNetSources" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(VisualNetSrc)\Matplotlib.Net')"
           Text="Visual.Net sources not found at '$(VisualNetRoot)'. Clone https://github.com/DotNetVibeCoderz/Vibe_Charting next to Vibe_ML, or set VISUALNET_ROOT to its Visual.Net folder." />
  </Target>

</Project>
